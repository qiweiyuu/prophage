Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"B", ",", "L1", ",", "L2", ",", "L12"}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Equations", " ", "of", " ", "motion"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Findsol", "[", 
     RowBox[{
     "L10_", ",", "L20_", ",", "B0_", ",", "b_", ",", "\[Alpha]_", ",", 
      "\[Delta]_", ",", "k_", ",", "S_", ",", "\[Alpha]L_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Deqs2", ",", "sol"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Deqs2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"B", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
           RowBox[{"S", "+", 
            RowBox[{
             RowBox[{"B", "[", "t", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"B", "[", "t", "]"}], "+", 
                 RowBox[{"L1", "[", "t", "]"}], "+", 
                 RowBox[{"L2", "[", "t", "]"}], "+", 
                 RowBox[{"L12", "[", "t", "]"}]}], ")"}]}], ")"}]}], "-", 
            RowBox[{"\[Delta]", " ", 
             RowBox[{"B", "[", "t", "]"}]}], "-", 
            RowBox[{"b", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"k", " ", 
                RowBox[{"L1", "[", "t", "]"}]}], "+", 
               RowBox[{"k", " ", 
                RowBox[{"L2", "[", "t", "]"}]}], "+", 
               RowBox[{"k", " ", 
                RowBox[{"L12", "[", "t", "]"}]}]}], ")"}], " ", 
             RowBox[{
              RowBox[{"B", "[", "t", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"B", "[", "t", "]"}], "+", 
                RowBox[{"L1", "[", "t", "]"}], "+", 
                RowBox[{"L2", "[", "t", "]"}], "+", 
                RowBox[{"L12", "[", "t", "]"}]}], ")"}]}]}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"L1", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
           RowBox[{
            RowBox[{"\[Alpha]L", " ", 
             RowBox[{"L1", "[", "t", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"B", "[", "t", "]"}], "+", 
                 RowBox[{"L1", "[", "t", "]"}], "+", 
                 RowBox[{"L2", "[", "t", "]"}], "+", 
                 RowBox[{"L12", "[", "t", "]"}]}], ")"}]}], ")"}]}], "-", 
            RowBox[{"\[Delta]", " ", 
             RowBox[{"L1", "[", "t", "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"k", " ", 
                RowBox[{"L1", "[", "t", "]"}]}], "+", 
               RowBox[{
                RowBox[{"k", "/", "2"}], " ", 
                RowBox[{"L12", "[", "t", "]"}]}]}], ")"}], " ", 
             RowBox[{
              RowBox[{"B", "[", "t", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"B", "[", "t", "]"}], "+", 
                RowBox[{"L1", "[", "t", "]"}], "+", 
                RowBox[{"L2", "[", "t", "]"}], "+", 
                RowBox[{"L12", "[", "t", "]"}]}], ")"}]}]}], "-", 
            RowBox[{"b", " ", 
             RowBox[{"L1", "[", "t", "]"}], " ", 
             RowBox[{
