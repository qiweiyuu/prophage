Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Variables", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"B", ",", "L1", ",", "L2", ",", "L12"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equations", " ", "of", " ", "motion"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "+", 
       RowBox[{"B", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}], ")"}]}], 
       "-", 
       RowBox[{"\[Delta]", " ", "B"}], "-", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "L1"}], "+", 
          RowBox[{"k", " ", "L2"}], "+", 
          RowBox[{"k", " ", "L12"}]}], ")"}], " ", 
        RowBox[{"B", "/", 
         RowBox[{"(", 
          RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}]}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"\[Alpha]L", " ", "L1", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}], ")"}]}], 
       "-", 
       RowBox[{"\[Delta]", " ", "L1"}], "+", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "L1"}], "+", 
          RowBox[{
           RowBox[{"k", "/", "2"}], " ", "L12"}]}], ")"}], " ", 
        RowBox[{"B", "/", 
         RowBox[{"(", 
          RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}]}], "-", 
       RowBox[{"b", " ", "L1", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", " ", "L2"}], "+", 
           RowBox[{
            RowBox[{"k", "/", "2"}], " ", "L12"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}]}], "-", 
       RowBox[{"k", " ", "L1"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", "L2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}], ")"}]}], 
       "-", 
       RowBox[{"\[Delta]", " ", "L2"}], "+", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "L2"}], "+", 
          RowBox[{
           RowBox[{"k", "/", "2"}], " ", "L12"}]}], ")"}], " ", 
        RowBox[{"B", "/", 
         RowBox[{"(", 
          RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}]}], "-", 
       RowBox[{"k", " ", "L2"}]}], ",", "  ", 
      RowBox[{
       RowBox[{"\[Alpha]L", " ", "\[Alpha]", " ", "L12", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"(", 
           RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}], ")"}]}], 
       "-", 
       RowBox[{"\[Delta]", " ", "L12"}], "+", "  ", 
       RowBox[{"b", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", " ", "L2"}], "+", 
          RowBox[{
           RowBox[{"k", "/", "2"}], " ", "L12"}]}], ")"}], " ", 
        RowBox[{"L1", "/", 
         RowBox[{"(", 
          RowBox[{"B", "+", "L1", "+", "L2", "+", "L12"}], ")"}]}]}], "-", 
       RowBox[{"k", " ", "L12"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Jacobian", " ", "matrix"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Jac", "=", 
    RowBox[{"D", "[", 
     RowBox[{"eqs", ",", 
      RowBox[{"{", "vars", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "find", " ", "stable", " ", "fixed", " ", 
    "points"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindStableFixed", "[", 
    RowBox[{
     RowBox[{"b_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Delta]_", "?", "NumericQ"}], ",", 
     RowBox[{"k_", "?", "NumericQ"}], ",", 
     RowBox[{"S_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sols", ",", "valid", ",", "stable"}], "}"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\< eqs. b=\>\"", ",", "b", ",", "\"\< \[Alpha]=\>\"", ",", 
         "\[Alpha]"}], "]"}], ";"}], "*)"}], 
     RowBox[{
      RowBox[{"sols", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"eqs", "==", "0"}], "]"}], ",", "vars"}], "]"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\< Sol:\>\"", ",", "sols"}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"valid", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"sols", ",", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{
            RowBox[{"vars", "/.", " ", "#"}], ",", 
            RowBox[{
             RowBox[{"0", "<=", "#", "<=", "1"}], "&"}]}], "]"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"valid1", "=", 
       RowBox[{"DeleteDuplicatesBy", "[", 
        RowBox[{"valid", ",", 
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Normal", "[", "#", "]"}], "/.", " ", 
             RowBox[{"x_Real", ":>", 
              RowBox[{"Round", "[", 
               RowBox[{"x", ",", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "8"}]}]}], "]"}]}]}], ",", "First"}], "]"}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stable", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"valid1", ",", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"eig", "=", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{
                RowBox[{"Jac", "/.", " ", "#"}], "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Alpha]L", "->", "\[Alpha]L"}], ",", 
                  RowBox[{"b", "->", "b"}], ",", 
                  RowBox[{"\[Delta]", "->", "\[Delta]"}], ",", 
                  RowBox[{"k", "->", "k"}], ",", 
                  RowBox[{"S", "->", "S"}]}], "}"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Re", "[", "eig", "]"}], ",", 
              RowBox[{
               RowBox[{"#", "<", "0"}], "&"}]}], "]"}]}], "]"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "stable"}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Classification", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyFixed", "[", "sol_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "nonzero"}], "}"}], ",", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"vars", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nonzero", "=", 
       RowBox[{"Pick", "[", 
        RowBox[{"vars", ",", "vals", ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", ">", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}], "&"}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"nonzero", "===", 
         RowBox[{"{", "B", "}"}]}], ",", "1", ",", 
        RowBox[{"nonzero", "===", 
         RowBox[{"{", 
          RowBox[{"B", ",", "L1"}], "}"}]}], ",", "2", ",", 
        RowBox[{"nonzero", "===", 
         RowBox[{"{", 
          RowBox[{"B", ",", "L2"}], "}"}]}], ",", "3", ",", 
        RowBox[{"nonzero", "===", 
         RowBox[{"{", 
          RowBox[{"B", ",", "L1", ",", "L2", ",", "L12"}], "}"}]}], ",", "4", 
        ",", "True", ",", "0"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", "Parameters", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
