           ",", "\[Alpha]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"classes", "===", 
         RowBox[{"{", "}"}]}], ",", "0", ",", 
        RowBox[{"First", "[", "classes", "]"}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
